# ==========================================
*.bin
*.pth
*.pt
*.pkl
*.pickle
*.npz
*.npy
*.onnx

# 模型检查点与评估子目录
models/checkpoints/
models/releases/
models/test/
models/test_parallel/
models/test_v2/
models/candidate_*
models/_candidate_*

# 允许受管的模型清单元数据（不含大权重）
!models/MANIFEST.jsonl
!models/bc_best_history.json

